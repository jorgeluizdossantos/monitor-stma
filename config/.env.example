# ============================================================================
# STMA - Modelo de arquivo de configuracao
#
# Este e o UNICO arquivo desta pasta versionado no Git.
# Os arquivos .env.development e .env.production sao ignorados (.gitignore).
#
# Para usar, copie este arquivo para:
#   config/.env.development   ->  lido por  npm run dev
#   config/.env.production    ->  lido por  npm run prod
# e preencha os valores reais.
# ============================================================================

# --- Ambiente ---------------------------------------------------------------
# development | production
NODE_ENV=development

# --- Backend (Express) ------------------------------------------------------
PORT=3001
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# --- Frontend (servidor estatico) -------------------------------------------
FRONTEND_PORT=5500
# Destino do proxy /api -> backend
API_TARGET_HOST=127.0.0.1
API_TARGET_PORT=3001

# --- Banco de dados (Aiven MySQL) -------------------------------------------
DB_HOST=preencha_o_host_da_aiven
DB_PORT=13997
DB_NAME=preencha_o_nome_da_base
DB_USER=preencha_o_usuario
DB_PASSWORD=preencha_a_senha
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Caminho relativo a pasta backend/
DB_SSL_CA_PATH=../frontend/CA-CERT/ca.pem
